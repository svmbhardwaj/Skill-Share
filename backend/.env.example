# Copy this file to .env and fill in your real values.
# This template IS committed; the .env you copy it to stays ignored by git.

# ============ Required — server refuses to start without these ============

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/skillshare

# JWT signing secret (must be at least 32 characters)
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars

# Google OAuth client ID
GOOGLE_CLIENT_ID=<client-id>.apps.googleusercontent.com

# Razorpay TEST MODE credentials (create at https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ============ Optional ============

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Public URL of the frontend (used for emails/links)
FRONTEND_URL=http://localhost:3000

# Gmail app credentials for sending password-reset emails
EMAIL_USER=
EMAIL_PASS=

NODE_ENV=development
PORT=5000

# If set, only Vercel preview deployments containing this name are allowed in production
VERCEL_PROJECT_NAME=
