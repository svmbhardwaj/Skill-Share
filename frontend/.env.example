# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control!

# Backend API URL (local or deployed)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:5000

# Google OAuth client ID (same as GOOGLE_CLIENT_ID in backend/.env)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay TEST MODE public key id (rzp_test_...) — optional.
# If left empty, the frontend uses the public key id returned by the
# backend when it creates a payment order. Only the public key belongs
# in the browser; RAZORPAY_KEY_SECRET stays server-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
